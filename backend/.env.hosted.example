# Append these hosted-migration settings to backend/.env; never commit real credentials.
# Local/preview remain loopback-only; hosted requires the Render launch checklist and runtime DB checks.
APP_MODE=local
# Neon pooled application URL; copy from Connect with connection pooling enabled.
DATABASE_URL=
# Neon direct migration URL; copy from Connect with connection pooling disabled.
DATABASE_DIRECT_URL=
# Public Auth Base URL from the same branch's Auth configuration; not a database URL.
NEON_AUTH_BASE_URL=
# Exact expected JWT claims; for the verified managed-service setup these are the HTTPS origin.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
# Signing algorithm confirmed against the configured branch's public JWKS.
NEON_AUTH_ALGORITHM=EdDSA
# Server-only Fernet key for saved provider credentials; generate using the setup helper.
PROVIDER_ENCRYPTION_KEY=

# Public deployment only. Leave approval false until secrets, CI, migrations, role, and auth origins are ready.
HOSTED_RELEASE_APPROVED=false
# Optional on Render, which supplies RENDER_EXTERNAL_URL; required elsewhere, HTTPS origin only.
PUBLIC_BASE_URL=
REQUEST_MAX_BYTES=524288
REQUEST_TIMEOUT_SECONDS=180
WORKSPACE_REQUESTS_PER_MINUTE=120
GLOBAL_REQUESTS_PER_MINUTE=600
WORKSPACE_INFERENCES_PER_DAY=100
WORKSPACE_HISTORY_LIMIT=1000
REQUEST_RETENTION_DAYS=30