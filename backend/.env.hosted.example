# Append these hosted-migration settings to backend/.env; never commit real credentials.
# Hosted API startup remains blocked until authentication and tenant routing are complete.
APP_MODE=local
# Neon pooled application URL; copy from Connect with connection pooling enabled.
DATABASE_URL=
# Neon direct migration URL; copy from Connect with connection pooling disabled.
DATABASE_DIRECT_URL=
# Public Auth Base URL from the same branch's Auth configuration; not a database URL.
NEON_AUTH_BASE_URL=
# Server-only Fernet key for saved provider credentials; generate using the setup helper.
PROVIDER_ENCRYPTION_KEY=