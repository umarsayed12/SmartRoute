# Environment settings for local SmartRoute development; copy to .env.
# Local Ollama server used by both small and medium tiers.
OLLAMA_BASE_URL=http://localhost:11434

# Optional remote model; leave blank to make large resolve to medium.
LARGE_MODEL=
# OpenAI-compatible API root, optionally ending in /v1.
LARGE_BASE_URL=
# Optional provider bearer credential; never commit a real key.
LARGE_API_KEY=
# Large-tier input price in USD per 1,000 tokens.
LARGE_INPUT_PRICE=0
# Large-tier output price in USD per 1,000 tokens.
LARGE_OUTPUT_PRICE=0

# Premium reference input price in USD per 1,000 tokens.
REFERENCE_INPUT_PRICE_PER_1K=0.0025
# Premium reference output price in USD per 1,000 tokens.
REFERENCE_OUTPUT_PRICE_PER_1K=0.010
# Minimum answer confidence before escalation is considered.
CONFIDENCE_THRESHOLD=0.6
# Maximum number of escalation steps per request.
MAX_ESCALATIONS=1
# Initial routing preference; persisted runtime settings can override this value.
ROUTING_MODE_PREFERENCE=auto

# SQLite database location, relative to the backend working directory.
DB_PATH=data/smartroute.db
# Trained router model location, relative to the backend working directory.
MODEL_PATH=data/router_model.joblib