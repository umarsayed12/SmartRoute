// Install and test the backend using its isolated Python environment.
{
	"version": "2.0.0",
	"windows": {
		"options": {
			"shell": {
				"executable": "powershell.exe",
				"args": ["-NoProfile", "-Command"]
			}
		}
	},
	"tasks": [
		{
			"label": "test: backend",
			"type": "shell",
			"command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"pytest",
				"-q",
				"backend/tests",
				"-o",
				"pythonpath=backend"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "install: backend",
			"type": "shell",
			"command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"pip",
				"install",
				"--disable-pip-version-check",
				"-r",
				"backend/requirements.txt"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}