// Run workspace validation and explicitly requested provider smoke tests.
{
	"version": "2.0.0",
	"windows": {
		"options": {
			"shell": {
				"executable": "powershell.exe",
				"args": ["-NoProfile", "-Command"]
			}
		}
	},
	"tasks": [
		{
			"label": "test: backend",
			"type": "shell",
			"command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"pytest",
				"-q",
				"backend/tests",
				"-o",
				"pythonpath=backend"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "install: backend",
			"type": "shell",
			"command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"pip",
				"install",
				"--disable-pip-version-check",
				"-r",
				"backend/requirements.txt"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "build: frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": ["--prefix", "${workspaceFolder}/frontend", "run", "build"],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "lint: frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": ["--prefix", "${workspaceFolder}/frontend", "run", "lint"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "smoke: maq routing",
			"type": "shell",
			"command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
			"args": ["-m", "scripts.try_maq_routing"],
			"options": { "cwd": "${workspaceFolder}/backend" },
			"isBackground": false,
			"problemMatcher": []
		}
	]
}